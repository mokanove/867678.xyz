---
import BaseLayout from "../layouts/BaseLayout.astro";
import Tables from "../components/Tables.astro";
import { getEntry, render } from "astro:content";
import "github-markdown-css/github-markdown.css";

const home = await getEntry("home", "home");
if (!home) throw new Error("home entry not found");
const { Content, headings } = await render(home);
---

<BaseLayout title="Home">
  <div class:list={["page-layout", { "has-toc": headings.length > 1 }]}>
    <article class="markdown-body">
      <Content />
    </article>
    {headings.length > 1 && <Tables headings={headings} />}
  </div>
</BaseLayout>
