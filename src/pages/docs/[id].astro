---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Tables from "../../components/Tables.astro";
import { getCollection, render } from "astro:content";
import "github-markdown-css/github-markdown.css";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((docs) => ({
    params: { id: docs.id },
    props: { docs },
  }));
}

const { docs } = Astro.props;
const { Content, headings } = await render(docs);
---

<BaseLayout title={docs.data.title}>
  <div class:list={["page-layout", { "has-toc": headings.length > 1 }]}>
    <article class="markdown-body">
      <Content />
    </article>
    {headings.length > 1 && <Tables headings={headings} />}
  </div>
</BaseLayout>
