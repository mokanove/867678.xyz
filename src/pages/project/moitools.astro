---
//css
import "../../style/moitools.css";
//components
import IndexPage from "../index.astro";
---

<IndexPage title="MoITools" childpage={true}>
  <div class="tools-page">
    <header class="tools-header">
      <p class="eyebrow">Mo Internet Test Tools</p>
      <div class="title-row">
        <h1>MoITools</h1>
      </div>
      <p class="tools-summary">
        A lightweight set of browser-based diagnostics for your current
        connection and device.
      </p>
    </header>

    <section class="tools-grid" aria-label="Network diagnostics">
      <article class="tool-card ip-card">
        <div class="card-heading">
          <div>
            <p class="card-kicker">Connection</p>
            <h2>IP information</h2>
          </div>
        </div>
        <div class="ip-sources" aria-live="polite">
          <section class="ip-source">
            <h3>ipinfo.io</h3>
            <p id="ipinfo-v4">IPv4: Getting data...</p>
            <p id="ipinfo-v6">IPv6: Getting data...</p>
            <p id="ipinfo-location">Location: Getting data...</p>
          </section>
          <section class="ip-source">
            <h3>ipip.net</h3>
            <p id="ipip-ip">IP: Getting data...</p>
            <p id="ipip-location">Location: Getting data...</p>
          </section>
          <section class="ip-source">
            <h3>ipify.org</h3>
            <p id="ipify-preferred">Preferred: Getting data...</p>
          </section>
        </div>
      </article>

      <article class="tool-card speed-card">
        <div class="card-heading">
          <div>
            <p class="card-kicker">Performance</p>
            <h2>Internet speedtest</h2>
          </div>
        </div>
        <dl class="metric-list">
          <div>
            <dt>Latency</dt>
            <dd id="latency" aria-live="polite">No data</dd>
          </div>
          <div>
            <dt>Upload</dt>
            <dd id="update-speed">Not available</dd>
          </div>
          <div>
            <dt>Download</dt>
            <dd id="download-speed" aria-live="polite">No data</dd>
          </div>
        </dl>
        <button id="sis" type="button">Run speedtest</button>
        <p>
          At the same time: you will be simultaneously request the following
          sites.
        </p>
        <p>
          speed.cloudflare.com cachefly.cachefly.net lax-ca-us-ping.vultr.com
          mirrors.jlu.edu.cn
        </p>
        <p>Speedtest will stay 5 seconds.</p>
      </article>

      <article class="tool-card client-card">
        <div class="card-heading">
          <div>
            <p class="card-kicker">Browser</p>
            <h2>Client information</h2>
          </div>
        </div>
        <dl class="detail-list">
          <div><dt>User Agent</dt><dd id="user-agent">Getting data...</dd></div>
          <div>
            <dt>System Language</dt><dd id="language">Getting data...</dd>
          </div>
          <div><dt>Timezone</dt><dd id="timezone">Getting data...</dd></div>
          <div><dt>HTTP/3 support</dt><dd id="h3">Getting data...</dd></div>
        </dl>
      </article>
    </section>

    <section class="secondary-section" aria-labelledby="privacy-tests-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Privacy</p>
          <h2 id="privacy-tests-title">Leak tests</h2>
        </div>
        <span class="coming-soon">Coming soon</span>
      </div>
      <div class="leak-grid">
        <div class="leak-item">
          <h3>WebRTC leak</h3>
          <p>Check whether your browser exposes an additional IP address.</p>
        </div>
        <div class="leak-item">
          <h3>DNS leak</h3>
          <p>Inspect which DNS resolvers your connection is currently using.</p>
        </div>
      </div>
    </section>

    <aside class="privacy-note">
      <div class="privacy-icon" aria-hidden="true">✓</div>
      <div>
        <h2>Tests run in your browser</h2>
        <p>
          MoITools is an open source project does not store your test results.
          Measurements are provided for reference and may vary with network
          conditions.
        </p>
      </div>
    </aside>
  </div>
</IndexPage>

<script>
  interface IpJson {
    ip?: string;
    region?: string;
  }

  const setText = (id: string, value: string): void => {
    const element = document.getElementById(id);
    if (element) element.textContent = value;
  };

  setText("user-agent", navigator.userAgent);
  setText("language", navigator.language);
  setText(
    "timezone",
    Intl.DateTimeFormat().resolvedOptions().timeZone || "Unknown",
  );
  const testHttp3 = async (): Promise<void> => {
    setText("h3", "Testing...");

    if (typeof performance.getEntriesByName !== "function") {
      setText("h3", "Not available");
      return;
    }

    try {
      let protocol = "";

      for (let attempt = 0; attempt < 2; attempt++) {
        const probeUrl = `/favicon.svg?h3-probe=${Date.now()}-${attempt}`;
        await fetch(probeUrl, { cache: "no-store" });
        const entry = performance
          .getEntriesByName(new URL(probeUrl, location.href).href, "resource")
          .at(-1) as PerformanceResourceTiming | undefined;
        protocol = entry?.nextHopProtocol?.toLowerCase() || "";
      }

      if (protocol === "h3" || protocol?.startsWith("h3-")) {
        setText("h3", "Supported (HTTP/3)");
      } else if (protocol) {
        setText("h3", `Not negotiated (${protocol})`);
      } else {
        setText("h3", "Not available");
      }
    } catch {
      setText("h3", "Test failed");
    }
  };

  const fetchIps = async (): Promise<void> => {
    const fetchJson = async (url: string): Promise<IpJson> => {
      const response = await fetch(url);
      if (!response.ok)
        throw new Error(`${response.status} ${response.statusText}`);
      return response.json();
    };

    const fetchIpip = async (): Promise<{ ip: string; location: string }> => {
      const response = await fetch("https://myip.ipip.net/");
      if (!response.ok)
        throw new Error(`${response.status} ${response.statusText}`);
      const text = await response.text();
      const match = text.match(/当前 IP：\s*(\S+).*?来自于：\s*(.+)/);
      if (!match) throw new Error("Unexpected ipip.net response");
      return { ip: match[1], location: match[2].trim() };
    };

    const [v4Result, v6Result, ipifyResult, ipipResult] =
      await Promise.allSettled([
        fetchJson("https://ipinfo.io/json"),
        fetchJson("https://v6.ipinfo.io/json"),
        fetchJson("https://api64.ipify.org/?format=json"),
        fetchIpip(),
      ]);

    const v4 = v4Result.status === "fulfilled" ? v4Result.value : {};
    const v6 = v6Result.status === "fulfilled" ? v6Result.value : {};
    const ipify = ipifyResult.status === "fulfilled" ? ipifyResult.value : {};
    const ipip =
      ipipResult.status === "fulfilled" ? ipipResult.value : undefined;

    setText("ipinfo-v4", `IPv4: ${v4.ip || "Unavailable"}`);
    setText("ipinfo-v6", `IPv6: ${v6.ip || "Unavailable"}`);
    setText(
      "ipinfo-location",
      `Location: ${v4.region || v6.region || "Unavailable"}`,
    );
    setText("ipip-ip", `IP: ${ipip?.ip || "Unavailable"}`);
    setText("ipip-location", `Location: ${ipip?.location || "Unavailable"}`);

    const preferred = ipify.ip?.includes(":")
      ? "IPv6"
      : ipify.ip
        ? "IPv4"
        : "Unavailable";
    setText("ipify-preferred", `Preferred: ${preferred}`);
  };

  const latencyEl = document.getElementById("latency") as HTMLElement;

  const Latency = async (): Promise<void> => {
    latencyEl.textContent = "Testing latency...";
    const targets = [
      "https://www.gstatic.com/generate_204",
      "https://i0.hdslb.com/",
      "https://www.apple.com/library/test/success.html",
    ];
    const samples: number[] = [];

    for (let i = 0; i < 10; i++) {
      const round = await Promise.allSettled(
        targets.map(async (url) => {
          const start = performance.now();
          await fetch(url, { mode: "no-cors", cache: "no-store" });
          return performance.now() - start;
        }),
      );
      round.forEach((result) => {
        if (result.status === "fulfilled") samples.push(result.value);
      });
      await new Promise((r) => setTimeout(r, 50));
    }

    if (samples.length) {
      latencyEl.textContent = `${Math.min(...samples).toFixed(1)} ms`;
    } else {
      latencyEl.textContent = "Error";
    }
  };

  const downloadEl = document.getElementById("download-speed") as HTMLElement;
  let isDownloading = false;
  const Download = async (): Promise<void> => {
    if (isDownloading) return;
    isDownloading = true;
    downloadEl.textContent = "Connecting...";

    const ctrl = new AbortController();
    const DURATION = 5000;
    const sources = [
      "https://speed.cloudflare.com/__down?bytes=1000000000",
      "https://cachefly.cachefly.net/100mb.test",
      "https://mirrors.jlu.edu.cn/ubuntu-releases/26.04/ubuntu-26.04-desktop-amd64.iso",
      "https://lax-ca-us-ping.vultr.com/vultr.com.1000MB.bin",
    ];
    const startTime = performance.now();
    let totalBytes = 0;

    const timer = setInterval(() => {
      const sec = (performance.now() - startTime) / 1000;
      if (sec > 0.5) {
        downloadEl.textContent = `${((totalBytes * 8) / 1e6 / sec).toFixed(2)} Mbps`;
      }
    }, 150);

    const task = async (url: string): Promise<void> => {
      while (!ctrl.signal.aborted && performance.now() - startTime < DURATION) {
        const res = await fetch(url, {
          signal: ctrl.signal,
          cache: "no-store",
        });
        if (!res.ok) throw new Error(`${res.status} ${res.statusText}`);
        const reader = res.body?.getReader();
        if (!reader) throw new Error("Response body is unavailable");
        while (true) {
          const { done, value } = await reader.read();
          if (done) break;
          if (value) totalBytes += value.length;
        }
      }
    };

    const abortTimer = setTimeout(() => ctrl.abort(), DURATION);

    try {
      await Promise.allSettled(sources.map(task));
    } finally {
      clearTimeout(abortTimer);
      clearInterval(timer);
      isDownloading = false;
      const finalSec = (performance.now() - startTime) / 1000;
      downloadEl.textContent =
        totalBytes > 0
          ? `${((totalBytes * 8) / 1e6 / finalSec).toFixed(2)} Mbps`
          : "Failed";
    }
  };

  let isTesting = false;
  const goBtn = document.getElementById("sis") as HTMLButtonElement;

  const Go = async (): Promise<void> => {
    if (isTesting) return;
    isTesting = true;
    goBtn.disabled = true;
    try {
      await Latency();
      await Download();
    } catch (e) {
      console.error("Something went wrong:", e);
    } finally {
      isTesting = false;
      goBtn.disabled = false;
    }
  };

  goBtn.addEventListener("click", Go);
  fetchIps();
  testHttp3();
</script>
